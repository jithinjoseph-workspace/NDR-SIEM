# NDR Stack — Environment Variables
# Copy to .env and fill in your values before running docker-compose.
# Generated automatically by install.sh; manual edits override it.

# ── Paths ────────────────────────────────────────────────────────────────────
# Absolute path to the NDR repository checkout (parent of docker-compose.yml)
INSTALL_DIR=/opt/ndr

# Home directory used for log files, vector config, and sensor config
HOME_DIR=/root

# ── Security ─────────────────────────────────────────────────────────────────
# Secret used to sign JWT tokens — must be random, at least 32 chars
JWT_SECRET=change-me-random-32-char-secret

# Shared secret between ndr-engine and ndr-agent for internal API calls
NDR_AGENT_SECRET=change-me-agent-secret

# ── Network ──────────────────────────────────────────────────────────────────
# CORS allowed origin — must match the URL users access the UI from
# Use https:// when TLS is enabled (the default after install.sh)
CORS_ORIGIN=https://192.168.1.1:3000

# Public IP of this host — used to filter the engine's own traffic from alerts
HOST_IP=192.168.1.1

# ── Sensor ───────────────────────────────────────────────────────────────────
# How the engine receives events: "agent" (via ndr-agent) or "central" (direct Kafka)
SENSOR_MODE=agent

# Unique identifier for the local sensor in "onpremise" profile
LOCAL_SENSOR_ID=local-central

# Default tenant assigned to events from the local sensor
TENANT_ID=default

# ── Arkime (PCAP capture) ────────────────────────────────────────────────────
# Base URL of the Arkime viewer API (leave empty to disable PCAP capture)
ARKIME_URL=http://localhost:8005

# Password for the Arkime admin account
ARKIME_PASS=admin

# ── AI providers ─────────────────────────────────────────────────────────────
# OpenAI API key — used for AI threat analysis and suppression (optional)
OPENAI_API_KEY=

# Groq API key — alternative/faster AI backend (optional)
GROQ_API_KEY=

# Groq model to use (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
