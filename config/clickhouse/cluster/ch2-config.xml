<clickhouse>
    <!-- Node 2: shifted ports — can't share 8123/9000 on host network -->
    <http_port>8124</http_port>
    <tcp_port>9001</tcp_port>
    <interserver_http_port>9010</interserver_http_port>
    <listen_host>0.0.0.0</listen_host>
    <!-- Disable unused ports to avoid conflicts with ch1 on shared host network -->
    <https_port remove="1"/>
    <tcp_port_secure remove="1"/>
    <interserver_https_port remove="1"/>
    <mysql_port remove="1"/>
    <postgresql_port remove="1"/>

    <!-- Same cluster definition as ch1 -->
    <remote_servers>
        <ndr_cluster>
            <shard>
                <replica>
                    <host>127.0.0.1</host>
                    <port>9000</port>
                </replica>
                <replica>
                    <host>127.0.0.1</host>
                    <port>9001</port>
                </replica>
            </shard>
        </ndr_cluster>
    </remote_servers>

    <zookeeper>
        <node>
            <host>127.0.0.1</host>
            <port>2181</port>
        </node>
    </zookeeper>

    <!-- Different macros for this node -->
    <macros>
        <shard>1</shard>
        <replica>ch2</replica>
    </macros>

    <logger>
        <level>warning</level>
    </logger>
</clickhouse>
